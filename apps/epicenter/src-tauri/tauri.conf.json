{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Whispering",
	"version": "1.2.2",
	"identifier": "so.epicenter",
	"build": {
		"beforeBuildCommand": "bun run build:desktop",
		"beforeDevCommand": {
			"script": "bun run build",
			"wait": true
		},
		"frontendDist": "frontend-placeholder"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [],
		"security": {
			"capabilities": [
				"trusted-epicenter-apps-production",
				"trusted-whispering-native-production",
				"trusted-whispering-overlay-production"
			],
			"csp": "default-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"category": "Productivity",
		"publisher": "kayomarz97",
		"copyright": "Fork of Whispering/Epicenter (AGPL-3.0-or-later) by kayomarz97",
		"shortDescription": "Voice dictation: record, transcribe, and clean up your speech",
		"externalBin": ["binaries/epicenter-host"],
		"resources": {
			"../dist": "apps-dist",
			"recorder-state-icons/studio_microphone.png": "recorder-state-icons/studio_microphone.png",
			"recorder-state-icons/red_large_square.png": "recorder-state-icons/red_large_square.png",
			"transcribe-libs/*": "./"
		},
		"icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
		"macOS": {
			"entitlements": "entitlements.plist",
			"hardenedRuntime": true,
			"minimumSystemVersion": "10.15",
			"signingIdentity": "-"
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["epicenter"]
			}
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4QzJDMTZBMDQ0RkQ0MzMKUldRejFFOEVhc0hDYUxDQllDdzQ3dytTOXYwbStjWng3MHJsVTlwWDlldXM5M0lJaFVXaHYzZ1MK",
			"endpoints": [
				"https://github.com/kayomarz97/whispering/releases/latest/download/latest.json"
			]
		}
	}
}
